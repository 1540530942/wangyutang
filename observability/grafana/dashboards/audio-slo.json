{
  "uid": "audio-slo",
  "title": "语音交互 SLO",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat", "title": "e2e 响应 P95 (说完→首块TTS)", "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 2.5 }, { "color": "red", "value": 4 } ] } } },
      "targets": [ { "expr": "histogram_quantile(0.95, sum(rate(audio_e2e_response_seconds_bucket[6h])) by (le))", "datasource": { "uid": "prom" } } ]
    },
    {
      "type": "stat", "title": "打断全程 P95 (插话→静音)", "id": 2,
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 0.3 }, { "color": "red", "value": 0.4 } ] } } },
      "targets": [ { "expr": "histogram_quantile(0.95, sum(rate(audio_bargein_cancel_delay_seconds_bucket[24h])) by (le))", "datasource": { "uid": "prom" } } ]
    },
    {
      "type": "stat", "title": "打断拖尾 P95", "id": 3,
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 0.15 }, { "color": "red", "value": 0.25 } ] } } },
      "targets": [ { "expr": "histogram_quantile(0.95, sum(rate(audio_bargein_tail_seconds_bucket[24h])) by (le))", "datasource": { "uid": "prom" } } ]
    },
    {
      "type": "stat", "title": "打断次数 (24h, 按停播来源)", "id": 4,
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "options": { "textMode": "value_and_name" },
      "targets": [ { "expr": "sum(increase(audio_bargein_total[24h])) by (stop_source)", "legendFormat": "{{stop_source}}", "datasource": { "uid": "prom" } } ]
    },
    {
      "type": "timeseries", "title": "分阶段时延 P95", "id": 5,
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(audio_asr_latency_seconds_bucket[30m])) by (le))", "legendFormat": "ASR", "datasource": { "uid": "prom" } },
        { "expr": "histogram_quantile(0.95, sum(rate(audio_route_latency_seconds_bucket[30m])) by (le))", "legendFormat": "路由+执行", "datasource": { "uid": "prom" } },
        { "expr": "histogram_quantile(0.95, sum(rate(audio_tts_first_chunk_seconds_bucket[30m])) by (le))", "legendFormat": "TTS首块", "datasource": { "uid": "prom" } }
      ]
    },
    {
      "type": "timeseries", "title": "轮次速率 (按状态)", "id": 6,
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "targets": [
        { "expr": "sum(increase(audio_turns_total[30m])) by (status)", "legendFormat": "{{status}}", "datasource": { "uid": "prom" } }
      ]
    },
    {
      "type": "timeseries", "title": "会话落盘 (按保留级)", "id": 7,
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(increase(audio_sessions_total[1h])) by (retention_tier)", "legendFormat": "{{retention_tier}}", "datasource": { "uid": "prom" } }
      ]
    },
    {
      "type": "timeseries", "title": "打断确认时延 (服务端 commit)", "id": 8,
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(audio_bargein_commit_delay_seconds_bucket[1h])) by (le))", "legendFormat": "commit P95", "datasource": { "uid": "prom" } }
      ]
    }
  ]
}
