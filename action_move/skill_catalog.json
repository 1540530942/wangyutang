{
  "version": 2,
  "robot": "TurboPi",
  "notes": [
    "Image calibration shows PWM servo 2 is the horizontal pan axis, while PWM servo 1 changes the vertical/pitch view.",
    "Left/right look skills use servo2=1800 for left and servo2=1200 for right after image-difference verification.",
    "Up/down look skills are mapped to the pitch axis on servo1 with conservative 1000/1700 positions.",
    "Base movement uses /cmd_vel and always publishes stop after a timed burst.",
    "Movement and turn commands are open-loop units. The web setting defines the requested unit distance or angle; the executor converts it to a bounded duration."
  ],
  "defaults": {
    "ros_container": "turbopi",
    "cmd_vel_topic": "/cmd_vel",
    "cmd_vel_topics": [
      "/cmd_vel",
      "/controller/cmd_vel"
    ],
    "pwm_servo_topic": "/ros_robot_controller/pwm_servo/set_state",
    "rgb_topic": "/ros_robot_controller/set_rgb",
    "rgb_led_indices": [
      1,
      2
    ],
    "sonar_rgb_enabled": true,
    "sonar_rgb_indices": [
      0,
      1
    ],
    "sonar_distance_samples": 7,
    "sonar_distance_sample_interval_ms": 40,
    "sonar_distance_conservative": true,
    "rgb_red": 0,
    "rgb_green": 0,
    "rgb_blue": 0,
    "unit_distance_cm": 5.0,
    "turn_angle_deg": 5.0,
    "sensitivity": 1.0,
    "move_duration_ms_at_5cm": 800,
    "turn_duration_ms_at_5deg": 450,
    "min_move_duration_ms": 180,
    "max_move_duration_ms": 3000,
    "min_turn_duration_ms": 180,
    "max_turn_duration_ms": 2500,
    "stop_publish_times": 3,
    "servo_duration_s": 0.35,
    "pwm_center": 1500,
    "camera_server": "https://www.wangyutang.cn/camera",
    "capture_after_servo": true,
    "capture_after_move": false,
    "capture_settle_ms": 500
  },
  "skills": [
    {
      "id": "emergency_stop",
      "name_zh": "急停",
      "description": "立即向 /cmd_vel 发布零速度，优先打断普通排队动作。",
      "type": "base_stop",
      "aliases": [
        "停止",
        "急停按钮",
        "刹车",
        "stop",
        "e-stop"
      ]
    },
    {
      "id": "reset_pose",
      "name_zh": "Reset",
      "description": "停止底盘，并将摄像头云台回到中心位置。",
      "type": "reset_pose",
      "aliases": [
        "复位",
        "重置",
        "回正",
        "reset",
        "云台回正"
      ]
    },
