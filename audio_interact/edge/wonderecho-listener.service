[Unit]
# WonderEchoPro -> audio_interact edge listener (Raspberry Pi / turbopi-01).
# Poll-daemon: when the audio_interact page sets input_mode=wonderechopro and
# manual_recording_enabled=true, this streams mic PCM over WebSocket /ws/audio
# (server Silero VAD -> ASR -> wake -> robot_sandbox -> streaming TTS) and plays
# the returned TTS sentence-by-sentence on the Pi speaker. Full duplex: mic keeps
# streaming during playback with echo cancellation + two-level barge-in.
#
# Install on the Pi:
#   python3 -m pip install -r requirements.txt
#   sudo cp wonderecho-listener.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now wonderecho-listener.service
Description=WonderEchoPro audio_interact listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/audio_interact_edge
ExecStart=/usr/bin/python3 /home/pi/audio_interact_edge/wonderecho_listener.py --config /home/pi/audio_interact_edge/config.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
