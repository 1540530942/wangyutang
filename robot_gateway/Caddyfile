{
	email {$ACME_EMAIL}
}

{$WWW_DOMAIN:localhost}, http://110.40.154.41 {
	encode zstd gzip
	root * /srv

	handle /api/health {
		header Content-Type application/json
		respond `{"status":"ok","service":"robot-gateway"}` 200
	}

	redir /slam /slam/ 308

	handle_path /camera/* {
		reverse_proxy {$CAMERA_UPSTREAM:camera-snapshot:8099}
	}

	handle_path /action/* {
		reverse_proxy {$ACTION_UPSTREAM:action-move:8094}
	}

	handle_path /robot_sandbox/* {
		reverse_proxy {$ROBOT_SANDBOX_UPSTREAM:robot-sandbox:8095}
	}

	handle_path /audio_interact/* {
		reverse_proxy {$AUDIO_INTERACT_UPSTREAM:audio-interact:8097}
	}

	handle /dashboard {
		reverse_proxy {$AUDIO_INTERACT_UPSTREAM:audio-interact:8097}
	}

	handle_path /common/* {
		reverse_proxy {$COMMON_UPSTREAM:host.docker.internal:8101}
	}

	handle_path /robot/* {
		reverse_proxy {$ROBOT_UPSTREAM:pi5-robot:8093}
	}

	handle_path /slam/* {
		reverse_proxy {$SLAM_UPSTREAM:slam-mapping:8301}
	}

	handle_path /face/* {
		reverse_proxy {$FACE_UPSTREAM:smile-face:8096}
	}

	file_server
}
