[Unit]
Description=Camera snapshot sender
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
ExecStart=/usr/bin/python3 /home/pi/pi_camera_sender.py --server https://www.wangyutang.cn/camera --device-id turbopi-01 --backend auto --camera-index 1 --ros-usb-cam-autostart
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
