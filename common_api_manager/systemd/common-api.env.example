# lv_server Qwen3.6-35B-A3B-MTP-GGUF (llama-server proxy on port 8013, tunnel :18002 → lv:8013 → 8012)
LV_CHAT_BASE_URL=http://127.0.0.1:18002
LV_CHAT_MODEL=Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
# lv_server vision shares the Qwen3.6 endpoint with mmproj enabled.
LV_VL_BASE_URL=http://127.0.0.1:18002
LV_VL_MODEL=Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
DASHSCOPE_LLM_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_HTTP_API_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_MODEL=qwen3-32b
VISION_MODEL=qwen-vl-plus
VISION_RESIZE_MAX_SIDE=1280
VISION_JPEG_QUALITY=85
# spark-c9a7 vLLM — requires common-api-spark-c9a7-tunnel.service running
SPARK_QWEN_BASE_URL=http://127.0.0.1:18000
SPARK_QWEN_MODEL=qwen3.6-35b-a3b
SPARK_QWEN_TIMEOUT_SECONDS=60
MODEL_USAGE_COLLECTOR_URL=http://127.0.0.1:18080/usage
